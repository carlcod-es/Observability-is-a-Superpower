{
  "mcpServers": {
    "aspire": {
      "type": "stdio",
      "command": "aspire",
      "args": ["agent", "mcp"]
    },
    "prometheus": {
      "type": "http",
      "url": "http://localhost:8090/mcp"
    },
    "grafana": {
      "type": "http",
      "url": "http://localhost:8091/mcp"
    }
  }
}
