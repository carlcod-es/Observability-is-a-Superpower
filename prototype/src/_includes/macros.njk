{% macro card(item) %}
<article class="card">
  <img class="card__image" src="{{ item.image }}" alt="{{ item.alt }}" width="640" height="360" loading="lazy">
  <div class="card__body">
    <h3 class="card__title"><a href="{{ item.url }}">{{ item.title }}</a></h3>
    {%- if item.start %}
    <p class="card__meta"><time datetime="{{ item.start }}">{{ item.startText }}</time></p>
    {%- endif %}
    <p class="card__summary">{{ item.summary }}</p>
    <p class="card__link"><a href="{{ item.url }}">Read more<span class="visually-hidden"> about {{ item.title }}</span></a></p>
  </div>
</article>
{% endmacro %}
