{
  "uid": "demo-site",
  "title": "Demo site",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate by page type",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (acme_page_type) (rate(http_server_request_duration_seconds_count{job=\"site\"}[1m]))",
          "legendFormat": "{{acme_page_type}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error rate (5xx)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(sum(rate(http_server_request_duration_seconds_count{job=\"site\",http_response_status_code=~\"5..\"}[1m])) or 0 * sum(rate(http_server_request_duration_seconds_count{job=\"site\"}[1m]))) / sum(rate(http_server_request_duration_seconds_count{job=\"site\"}[1m]))",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Request duration p95 by page type",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (acme_page_type, le) (rate(http_server_request_duration_seconds_bucket{job=\"site\"}[1m])))",
          "legendFormat": "{{acme_page_type}}",
          "exemplar": true
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Error logs",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{service_name=\"site\"} | detected_level=\"error\"",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Form submissions by outcome",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (acme_form, acme_form_outcome) (increase(acme_forms_submissions_total{job=\"site\"}[1m]))",
          "legendFormat": "{{acme_form}} {{acme_form_outcome}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Bookings: stored vs counted",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(acme_forms_submissions_total{job=\"site\",acme_form=\"event_booking\",acme_form_outcome=\"stored\"}[1m])) or vector(0)",
          "legendFormat": "stored"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(acme_bookings_counted_total{job=\"api\"}[1m])) or vector(0)",
          "legendFormat": "counted"
        }
      ]
    }
  ]
}
