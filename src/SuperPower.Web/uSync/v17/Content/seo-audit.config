        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Find out what is holding your rankings back"
        }
      ]
    },
    {
      "contentTypeKey": "f19290b1-ce56-4496-90dd-c4750836878e",
      "key": "255660a7-19a2-4f62-b247-91061e239e62",
      "values": [
        {
          "alias": "mainContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EA full crawl and review of your site\u0027s technical SEO, content and rankings, with a prioritised action list. Search engines reward sites that are fast, well structured and easy to crawl. Small technical problems, such as broken links, duplicate pages or missing metadata, quietly cost you traffic. An audit finds them before they add up.\u003C/p\u003E\u003Cp\u003EWe crawl every page and compare what we find with your rankings and search console data. We look at page speed, structured data, internal linking, redirects and how well your content matches what people search for. Each finding is checked by a person, not just reported by a tool. That keeps the list short and relevant.\u003C/p\u003E\u003Cp\u003EYou get a short report with the problems that cost you the most traffic first. Every item has a clear fix, an estimate of the effort and the expected impact. Your team can work through it, or we can do the work for you. We are happy to walk you through the report in a short call.\u003C/p\u003E"
          }
        }
      ]
    }
  ],
  "settingsData": [],
