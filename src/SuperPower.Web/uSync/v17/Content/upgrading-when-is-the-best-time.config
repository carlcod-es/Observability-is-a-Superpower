    },
    {
      "contentTypeKey": "f19290b1-ce56-4496-90dd-c4750836878e",
      "key": "3efd6aed-9e53-4f50-be69-76f70cfc8401",
      "values": [
        {
          "alias": "mainContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EUpgrades are easier to put off than to plan. There is always a new feature or campaign that feels more urgent. But every release you skip makes the next upgrade bigger and riskier. This session helps you decide when the time is right.\u003C/p\u003E\u003Cp\u003EWe look at the Umbraco release cycle and what long-term support means for your site. We compare the cost of upgrading now with the cost of waiting, including security fixes and package support. We also cover the warning signs that an upgrade can no longer wait. Real upgrade stories show what went well and what did not.\u003C/p\u003E\u003Cp\u003EYou will leave with a simple checklist for planning your next upgrade. It covers the audit, the budget, the timing and who needs to be involved. The session suits site owners, project managers and developers alike.\u003C/p\u003E"
          }
        }
      ]
    }
  ],
