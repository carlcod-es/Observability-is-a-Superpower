        {
          "alias": "mainContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EEditors spend more time in the backoffice than anyone else. When the editing experience is confusing, content suffers and mistakes reach the live site. A few good decisions during the build make a big difference. This session shows which ones matter most.\u003C/p\u003E\u003Cp\u003EWe cover how to design document types that match the way editors think about content. We look at block editors that give flexibility without breaking the design. We show how clear labels, descriptions and previews reduce support requests. Each idea comes with an example you can reuse.\u003C/p\u003E\u003Cp\u003EThe session is aimed at developers and designers who build Umbraco sites. Editors are welcome too, and their feedback is often the best part of the discussion. You will leave with a checklist to review your own sites against.\u003C/p\u003E"
          }
        }
      ]
    }
  ],
  "settingsData": [],
