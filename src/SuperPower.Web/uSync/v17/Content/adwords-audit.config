      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Stop paying for clicks that do not convert"
        }
      ]
    },
    {
      "contentTypeKey": "f19290b1-ce56-4496-90dd-c4750836878e",
      "key": "9106bbe3-572a-4422-944c-afa47d9ba9ab",
      "values": [
        {
          "alias": "mainContent",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EWe review your Google Ads accounts for wasted spend, weak keywords and missing conversions. Paid search accounts tend to grow messy over time as campaigns are added and rarely removed. Budget drifts to keywords that bring clicks but no leads. Most accounts we review have savings waiting to be found.\u003C/p\u003E\u003Cp\u003EWe go through your campaigns, ad groups, keywords and search terms one by one. We check that conversion tracking records the leads and sales that matter to you. We compare bids and budgets with the results each campaign actually delivers. Where ads underperform, we look at the copy and the landing pages behind them.\u003C/p\u003E\u003Cp\u003EThe result is a list of changes ranked by savings, from negative keywords and bid adjustments to conversion tracking that actually records your leads. Quick wins come first, so you see results within weeks. We can make the changes for you or coach your team through them.\u003C/p\u003E"
          }
        }
      ]
    }
  ],
  "settingsData": [],
